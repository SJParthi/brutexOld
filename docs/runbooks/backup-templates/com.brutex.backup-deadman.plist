<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd template — hourly BruteX backup dead-man check (DEC-BACKUP-OFFBOX-001).
     GENERATED by brutex/backup/schedule_render.py — edit the renderer, not this file
     (a golden test pins byte-equality). Replace every {{PLACEHOLDER}}; NO secrets here:
     the restic password rides BRUTEX_BACKUP_PASSWORD_FILE (0600) or _COMMAND; S3/B2 creds
     ride ~/.brutex/.env, loaded by bootstrap_env() at dispatch.
     Deliberately NO repo env: the shallow check must work when the backup env
     is broken; the daily deep check self-gates inside the hourly tick. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.brutex.backup-deadman</string>
  <key>ProgramArguments</key><array>
    <string>{{BRUTEX_VENV_BIN}}/brutex</string><string>backup</string><string>check</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>ThrottleInterval</key><integer>300</integer>
  <key>EnvironmentVariables</key><dict>
    <!-- fill AFTER the healthchecks.io check exists (runbook step 10 / M6); until
         then set the value below to an EMPTY string (blank reads as unset) — never
         leave the literal placeholder (any non-http(s) value is refused with a WARN
         every tick while `backup status` reads SET). The hourly checker reads THIS
         value: launchd env OVERRIDES ~/.brutex/.env, so set the URL here and
         bootout+bootstrap the agent. A .env-only URL works only if this key is
         DELETED — a blank value here still reaches the checker as a PRESENT (empty)
         env var, and bootstrap_env never overrides a present var (blank included),
         so blank keeps the ping lane OFF while a shell-run `backup status` (no
         launchd env) reads SET. -->
    <key>BRUTEX_BACKUP_HEALTHCHECK_URL</key><string>{{BRUTEX_BACKUP_HEALTHCHECK_URL}}</string>
    <key>PATH</key><string>{{BRUTEX_VENV_BIN}}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key><string>{{BRUTEX_LOG_DIR}}/deadman.out.log</string>
  <key>StandardErrorPath</key><string>{{BRUTEX_LOG_DIR}}/deadman.err.log</string>
</dict></plist>
