<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd template — nightly BruteX off-box backup (DEC-BACKUP-OFFBOX-001).
     GENERATED by brutex/backup/schedule_render.py — edit the renderer, not this file
     (a golden test pins byte-equality). Replace every {{PLACEHOLDER}}; NO secrets here:
     the restic password rides BRUTEX_BACKUP_PASSWORD_FILE (0600) or _COMMAND; S3/B2 creds
     ride ~/.brutex/.env, loaded by bootstrap_env() at dispatch. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.brutex.backup</string>
  <key>ProgramArguments</key><array>
    <string>{{BRUTEX_VENV_BIN}}/brutex</string><string>backup</string><string>run</string>
