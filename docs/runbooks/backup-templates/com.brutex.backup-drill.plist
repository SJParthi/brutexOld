<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd template — monthly BruteX backup restore drill (DEC-BACKUP-OFFBOX-001).
     GENERATED by brutex/backup/schedule_render.py — edit the renderer, not this file
     (a golden test pins byte-equality). Replace every {{PLACEHOLDER}}; NO secrets here:
     the restic password rides BRUTEX_BACKUP_PASSWORD_FILE (0600) or _COMMAND; S3/B2 creds
     ride ~/.brutex/.env, loaded by bootstrap_env() at dispatch. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.brutex.backup-drill</string>
  <key>ProgramArguments</key><array>
    <string>{{BRUTEX_VENV_BIN}}/brutex</string><string>backup</string><string>restore-drill</string>
  </array>
  <key>StartCalendarInterval</key><dict>
    <key>Day</key><integer>1</integer>
    <key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>ThrottleInterval</key><integer>300</integer>
  <key>EnvironmentVariables</key><dict>
    <key>BRUTEX_LAKE_ROOT</key><string>{{BRUTEX_LAKE_ROOT}}</string>
    <key>BRUTEX_BACKUP_REPO</key><string>{{BRUTEX_BACKUP_REPO}}</string>
    <!-- keychain _COMMAND route (runbook step 4): set the value below to an EMPTY
         string (blank reads as unset) or delete this key — never leave the literal
         placeholder: any non-blank value alongside the .env _COMMAND is the
         ambiguous-source EXIT_CONFIG refusal (F6). -->
    <key>BRUTEX_BACKUP_PASSWORD_FILE</key><string>{{BRUTEX_BACKUP_PASSWORD_FILE}}</string>
    <key>PATH</key><string>{{BRUTEX_VENV_BIN}}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key><string>{{BRUTEX_LOG_DIR}}/drill.out.log</string>
  <key>StandardErrorPath</key><string>{{BRUTEX_LOG_DIR}}/drill.err.log</string>
</dict></plist>
