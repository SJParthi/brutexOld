# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/
dist/
build/
*.whl

# Virtual envs
.venv/
.venv*/
# File/symlink form too — `.venv*/` matches directories only, which let a
# session-local `.venv-gates` SYMLINK get swept into a commit (removed in the
# .venv-gates cleanup); the non-slash pattern covers symlinks + plain files.
.venv*
.venv312/
.devvenv/
venv/
env/
.env

# uv lockfile — generated by `uv run`/`uv lock`, not a tracked source artifact
# (mirrors the Cargo.lock policy below; the project resolves from pyproject.toml).
uv.lock
.envrc

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mutmut-cache
.hypothesis/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
# pytest-benchmark JSON artifact (CI writes + uploads it; never tracked)
bench-results.json

# Tooling
.DS_Store
*.swp
*.swo
.idea/
# …but DO track the shared run configuration so "clone → click ▶ Run"
# works out of the box (DEC-ONECLICK-RUN-001).
!.idea/
.idea/*
!.idea/runConfigurations/
.vscode/
*.code-workspace

# BruteX runtime data (runtime lake & audit output — NOT the
# brutex/data source package)
/data/
raw/
canonical/
audit/
cache/
runs/
*.lmdb
*.parquet
# … but the byte-frozen golden fixtures ARE committed (optional-column
# back-compat corpora, DEC-VIX-STAMP-WIRE-001 — see tests/golden/fixtures/README.md)
!tests/golden/fixtures/*.parquet
# Repo-root panel/repro sweep-output scratch trees (e.g. stage3vix<random>/ from
# adversarial-review repros): the *.parquet halves are already ignored above, but
# the audit.jsonl + *.trials.json sidecars were `git add -A`-committable — ignore
# the whole tree so a repro can never be staged (DEC-VIX-STAMP-WIRE-001 round-5).
/stage3vix*/
*.arrow
*.zst
*.zstd

# Secrets — NEVER commit
.env.local
.env.*.local
secrets/
**/api_token*
**/groww_token*
**/groww_access_token*
**/access_token*
*_API_AUTH_TOKEN*
*_ACCESS_TOKEN*

# Operator secrets — must NEVER be committed (default lives in ~/.brutex, but guard the repo too)
credentials.json
*.credentials.json
.brutex/

# In-repo log redirect target (make run-raw LOG_DIR=./.brutex-logs → BRUTEX_LOG_DIR)
.brutex-logs/

# In-project log visibility symlink (DEC-LOGS-IN-PROJECT-001): up.sh creates/refreshes
# <repo>/logs → the resolved log directory (default ~/.brutex/logs) so the IntelliJ
# project tree shows the live log. A machine-local pointer — never committed.
/logs

# Local sweep-validation artifacts — synthetic lake + sweep outputs from
# pipeline-mechanics runs. NEVER commit: these are throwaway artifacts and the
# synthetic OHLC must not be mistaken for real market data (Golden Rule #1).
.synth/
.sweep-results/
.sweep-results-clean/
.sweep-scale/

# Rust (future P3)
target/
Cargo.lock

# cargo-mutants scratch + reports — throwaway, never commit
**/mutants.out/
**/mutants.out.old/
**/cargo-mutants.out/
**/mutants-full.out/
**/mutants-verify.out/
# proptest persists failure seeds here; the only ones generated so far were
# induced by cargo-mutants mutants (not real failures), so they are scratch.
# The seeds live in a directory literally named `proptest-regressions/`, so the
# glob must match the DIRECTORY — the old `**/*.proptest-regressions` (a trailing
# `.proptest-regressions` suffix) never matched the real dir and left it untracked.
**/proptest-regressions/
# Retained (below) for back-compat: still ignores any dot-suffixed
# `*.proptest-regressions` path; the directory glob above is the effective rule.
**/*.proptest-regressions
# ...but the fno-math extension crate IS an application artifact: track its
# lockfile for reproducibility (Golden Rule #4) + the security-audit
# Cargo.lock trigger (DEC-RUST-RAYON-SUPERMASK-001, first new-crate PR).
!rust/fno-math/Cargo.lock
# Same law for the brutex-feed decision kernel + its fuzz harness
# (DEC-FEED-RUST-CORE-001 — the trading-core lockfiles predate the glob and
# stay tracked; a NEW crate needs its own negation to be addable).
!rust/brutex-feed/Cargo.lock
!rust/brutex-feed/fuzz/Cargo.lock
# Same law for the brutex-strategies combo byte-law kernel
# (DEC-STRATEGIES-RUST-COMBO-001 — a NEW crate needs its own negation to be
# addable; the FRESH lock is committed, never a copy of a sibling's).
!rust/brutex-strategies/Cargo.lock
# brutexd (the Rust HTTP front, Rust-uniformity Wave 1) is likewise an
# application BINARY crate: its lockfile is tracked for reproducible builds
# (Golden Rule #4) + the security-audit Cargo.lock trigger.
!rust/brutexd/Cargo.lock
# brutex-pull-state (the pull-state decision kernel, DEC-RUST-PULL-STATE-001
# lane) is likewise an application extension crate: its lockfile is tracked
# for reproducible builds (Golden Rule #4) + the security-audit Cargo.lock
# trigger.
!rust/brutex-pull-state/Cargo.lock

# Worker/agent scratch dir — throwaway venvs, tool caches, mutation-testing
# scratch, built wheels, and disposable test lakes created by Claude Code agents.
# NEVER a tracked source artifact; ignoring it keeps the tree clean between runs.
scratchpad/

# Claude Code transient state — isolated background-agent worktrees (auto-cleaned)
.claude/worktrees/

# Personal Claude Code local settings (not shared)
.claude/settings.local.json

# DEC-BENCH-ABS-BASELINE-001: runner-local absolute-bench fragments/candidate
# working dir; committed baselines live ONLY under tests/bench/baselines/.
abs-bench/

# DEC-SWEEP-RESULTS-DEPTH-001 (gap-register ruling 5, B2): the pre-extension
# results-store GOLDEN is a committed, frozen REAL store file — exempt it
# (exact path only) from the runtime-lake *.parquet ignore above.
!tests/golden/fixtures/results_store_pre_extension_v1.parquet
# Headless-browser truth-suite failure artifacts (DEC-DASHBOARD-BROWSER-TRUTH-001):
# Playwright traces/screenshots/ledgers saved on test FAILURE only — never committed.
test-artifacts/
