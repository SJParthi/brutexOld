dist/
build/
*.whl

# Virtual envs
.venv/
.venv*/
.venv312/
.devvenv/
venv/
env/
.env

# uv lockfile — generated by `uv run`/`uv lock`, not a tracked source artifact
# (mirrors the Cargo.lock policy below; the project resolves from pyproject.toml).
uv.lock
.envrc

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mutmut-cache
.hypothesis/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
# pytest-benchmark JSON artifact (CI writes + uploads it; never tracked)
bench-results.json

# Tooling
.DS_Store
*.swp
*.swo
.idea/
# …but DO track the shared run configuration so "clone → click ▶ Run"
# works out of the box (DEC-ONECLICK-RUN-001).
!.idea/
.idea/*
!.idea/runConfigurations/
.vscode/
*.code-workspace

# BruteX runtime data (runtime lake & audit output — NOT the
# brutex/data source package)
/data/
raw/
canonical/
audit/
cache/
runs/
*.lmdb
*.parquet
*.arrow
*.zst
*.zstd

# Secrets — NEVER commit
.env.local
.env.*.local
secrets/
**/api_token*
**/groww_token*
**/access_token*
*_API_AUTH_TOKEN*
*_ACCESS_TOKEN*

# Operator secrets — must NEVER be committed (default lives in ~/.brutex, but guard the repo too)
credentials.json
*.credentials.json
.brutex/

# In-repo log redirect target (make run LOG_DIR=./.brutex-logs → BRUTEX_LOG_DIR)
.brutex-logs/

# Local sweep-validation artifacts — synthetic lake + sweep outputs from
# pipeline-mechanics runs. NEVER commit: these are throwaway artifacts and the
# synthetic OHLC must not be mistaken for real market data (Golden Rule #1).
.synth/
.sweep-results/
.sweep-results-clean/
.sweep-scale/

# Rust (future P3)
target/
Cargo.lock

# cargo-mutants scratch + reports — throwaway, never commit
**/mutants.out/
**/mutants.out.old/
**/cargo-mutants.out/
**/mutants-full.out/
**/mutants-verify.out/
# proptest persists failure seeds here; the only ones generated so far were
# induced by cargo-mutants mutants (not real failures), so they are scratch.
**/*.proptest-regressions
# ...but the fno-math extension crate IS an application artifact: track its
# lockfile for reproducibility (Golden Rule #4) + the security-audit
# Cargo.lock trigger (DEC-RUST-RAYON-SUPERMASK-001, first new-crate PR).
!rust/fno-math/Cargo.lock

# Claude Code transient state — isolated background-agent worktrees (auto-cleaned)
.claude/worktrees/

# Personal Claude Code local settings (not shared)
.claude/settings.local.json
